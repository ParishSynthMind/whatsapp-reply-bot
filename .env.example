# Copy to .env and fill in once a Twilio account and WhatsApp sender exist.
# Never commit the real .env file.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000

# Comma-separated whatsapp:+<E.164> numbers allowed to use the bot.
TRUSTED_WHATSAPP_NUMBERS=whatsapp:+10000000001,whatsapp:+10000000002
